{
  "name": "claret-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --host",
    "server": "node server/index.mjs",
    "ingest": "node scripts/ingest.mjs",
    "curate:enrich": "node scripts/curate-enrich.mjs",
    "mint": "node scripts/stripe-mint.mjs",
    "sold:stripe": "node scripts/stripe-sold.mjs",
    "build": "vite build",
    "build:pages": "vite build && node scripts/snapshot.mjs && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "stage": "node scripts/stage.mjs",
    "preview": "vite preview --port 5180",
    "reveal": "node scripts/reveal-probe.mjs",
    "audit": "node scripts/audit.mjs",
    "smoke": "node scripts/smoke.mjs",
    "layout": "node scripts/layout.mjs",
    "ux": "node scripts/ux-probe.mjs",
    "a11y": "node scripts/a11y-probe.mjs",
    "headers": "node scripts/headers-probe.mjs",
    "integration": "node scripts/integration.mjs",
    "deploy:check": "npm run build && node scripts/deploy.mjs",
    "check": "node scripts/audit.mjs && node scripts/smoke.mjs && node scripts/integration.mjs",
    "check:all": "node scripts/audit.mjs && node scripts/smoke.mjs && node scripts/integration.mjs && node scripts/layout.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "animejs": "^4.5.0",
    "motion": "^12.43.0"
  }
}
