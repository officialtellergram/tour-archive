# Tour Archive — inventory API configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# These are read ONLY by server/ — nothing here reaches the browser bundle.

# ─────────────────────────────── eBay ───────────────────────────────
# From developer.ebay.com → Application Keys. You need a keyset for whichever
# environment you point at; sandbox and production keys are NOT interchangeable.
EBAY_ENABLED=false
EBAY_ENV=sandbox                    # sandbox | production
EBAY_CLIENT_ID=                     # "App ID (Client ID)" on the keys page
EBAY_CLIENT_SECRET=                 # "Cert ID (Client Secret)" — secret, server-only
EBAY_SELLER_USERNAME=               # the eBay username whose listings populate the site
EBAY_MARKETPLACE_ID=EBAY_US         # EBAY_US | EBAY_GB | …
# Browse rejects a bare seller filter, so requests are anchored to a category.
# 137084 = Sporting Goods > Golf > Golf Clothing, Shoes & Accessories.
EBAY_CATEGORY_IDS=137084
EBAY_LIMIT=200

# ────────────────────────────── Depop ───────────────────────────────
# NOT self-serve. Access is granted under an executed partnership Order Form and
# credentials are issued by Depop. Leave disabled until those arrive.
DEPOP_ENABLED=false
DEPOP_BASE_URL=https://partnerapi.depop.com
DEPOP_API_KEY=
DEPOP_SHOP_ID=
DEPOP_LIMIT=200

# ────────────────────────────── Server ──────────────────────────────
PORT=5181
CORS_ORIGIN=http://localhost:5180
CACHE_TTL_SECONDS=900               # how long a successful sync stays fresh
CACHE_STALE_IF_ERROR=true           # serve stale stock rather than an empty shop
