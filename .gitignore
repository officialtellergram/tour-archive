node_modules/
dist/
shots/
.cache/
# every env variant except the documented example — ROBOT_PASSWORD lives in
# .env, and .env.bak / .env.local / editor copies must never slip into a commit
.env*
!.env.example
# any log, not just the ones we happen to produce today — a scheduled task
# writing into the repo root is how a log gets committed by accident
*.log
